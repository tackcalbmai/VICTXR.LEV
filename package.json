{
  "name": "victxr-lev",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "node scripts/postbuild.mjs",
    "check": "astro check",
    "preview": "astro preview",
    "audit:deps": "npm audit --audit-level=high",
    "audit:static": "node tests/static-audit.mjs",
    "audit:quality": "node tests/quality-gates.mjs",
    "audit:contacts": "node tests/contact-channels.mjs",
    "cross-browser": "node tests/cross-browser.mjs",
    "visual": "npm run audit:static && node tests/visual.mjs && node tests/cinematic-intro.mjs && node tests/brand-motion.mjs && npm run cross-browser && npm run audit:quality",
    "test": "npm run check && npm run build && npm run visual",
    "deploy": "npm run check && npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.6.0",
    "astro": "^7.1.6",
    "gsap": "^3.15.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "playwright": "^1.60.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.115.0"
  }
}
