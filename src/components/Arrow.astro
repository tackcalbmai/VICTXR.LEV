---
interface Props {
  direction?: 'up' | 'down' | 'right' | 'left';
  class?: string;
}

const { direction = 'right', class: className = '' } = Astro.props;
---

<svg class:list={['ui-arrow', 'brand-arrow', `brand-arrow--${direction}`, className]} viewBox="0 0 24 20" aria-hidden="true">
  <path class="brand-arrow__spine" d="M1.6 10H15.35" />
  <path class="brand-arrow__blade brand-arrow__blade--top" d="M12.55 4.75L19.35 10" />
  <path class="brand-arrow__blade brand-arrow__blade--bottom" d="M12.55 15.25L19.35 10" />
</svg>

<style>
  .brand-arrow {
    --brand-arrow-angle: 0deg;
    width: 1.22rem;
    height: 1.22rem;
    stroke-width: 1.48;
    stroke-linecap: butt;
    stroke-linejoin: miter;
    transform: rotate(var(--brand-arrow-angle));
    transform-origin: 50% 50%;
    transition: transform 360ms var(--ease-out);
  }

  .brand-arrow--down { --brand-arrow-angle: 90deg; }
  .brand-arrow--left { --brand-arrow-angle: 180deg; }
  .brand-arrow--up { --brand-arrow-angle: -90deg; }

  .brand-arrow__spine,
  .brand-arrow__blade {
    vector-effect: non-scaling-stroke;
  }

  .brand-arrow__blade {
    transform-box: fill-box;
    transform-origin: right center;
    transition: transform 360ms var(--ease-out);
  }

  .brand-arrow__blade--top {
    transform: scaleX(0.955);
  }

  .brand-arrow__blade--bottom {
    transform: scaleX(1.045);
  }

  :global(a:hover) .brand-arrow,
  :global(a:focus-visible) .brand-arrow {
    transform: rotate(var(--brand-arrow-angle)) translateX(0.17rem);
  }

  :global(a:hover) .brand-arrow__blade,
  :global(a:focus-visible) .brand-arrow__blade {
    transform: scaleX(1);
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-arrow,
    .brand-arrow__blade {
      transition: none;
    }
  }
</style>
