---
interface Props {
  direction?: 'up' | 'down' | 'right' | 'left';
  class?: string;
}

const { direction = 'right', class: className = '' } = Astro.props;
---

<svg class:list={['ui-arrow', 'brand-arrow', `brand-arrow--${direction}`, className]} viewBox="0 0 32 22" aria-hidden="true" fill="none">
  <g class="brand-arrow__main">
    <path d="M3 11H23.25" />
    <path d="M18.2 5.9L23.55 11L18.2 16.1" />
  </g>
  <path class="brand-arrow__signal" pathLength="1" d="M3 11H23.25" />
</svg>

<style>
  .brand-arrow {
    --brand-arrow-angle: 0deg;
    width: 1.32rem;
    height: 1.32rem;
    overflow: visible;
    transform: rotate(var(--brand-arrow-angle));
    transform-origin: 50% 50%;
    transition: transform 440ms var(--ease-out);
  }

  .brand-arrow--down { --brand-arrow-angle: 90deg; }
  .brand-arrow--left { --brand-arrow-angle: 180deg; }
  .brand-arrow--up { --brand-arrow-angle: -90deg; }

  .brand-arrow__main,
  .brand-arrow__signal {
    vector-effect: non-scaling-stroke;
  }

  .brand-arrow__main {
    stroke: currentColor;
    stroke-width: 1.82;
    stroke-linecap: square;
    stroke-linejoin: miter;
    opacity: 0.56;
    transform-box: fill-box;
    transform-origin: left center;
    transition:
      opacity 320ms ease,
      transform 440ms var(--ease-out);
  }

  .brand-arrow__signal {
    stroke: var(--accent);
    stroke-width: 2.08;
    stroke-linecap: round;
    stroke-dasharray: 0.11 0.89;
    stroke-dashoffset: 0.86;
    opacity: 0;
    animation: brand-arrow-flow 1.75s var(--ease-in-out) infinite;
  }

  :global(a:hover) .brand-arrow,
  :global(a:focus-visible) .brand-arrow {
    transform: rotate(var(--brand-arrow-angle)) translateX(0.15rem);
  }

  :global(a:hover) .brand-arrow__main,
  :global(a:focus-visible) .brand-arrow__main {
    opacity: 0.82;
    transform: scaleX(1.025);
  }

  :global(a:hover) .brand-arrow__signal,
  :global(a:focus-visible) .brand-arrow__signal {
    animation-duration: 1.05s;
  }

  @keyframes brand-arrow-flow {
    0% {
      stroke-dashoffset: 0.86;
      opacity: 0;
    }
    14% {
      opacity: 0.82;
    }
    76% {
      opacity: 0.82;
    }
    100% {
      stroke-dashoffset: -0.16;
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-arrow,
    .brand-arrow__main {
      transition: none;
    }

    .brand-arrow__signal {
      display: none;
      animation: none;
    }
  }
</style>
