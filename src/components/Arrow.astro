---
interface Props {
  direction?: 'up' | 'down' | 'right' | 'left';
  class?: string;
}

const { direction = 'right', class: className = '' } = Astro.props;
---

<svg class:list={['ui-arrow', 'brand-arrow', `brand-arrow--${direction}`, className]} viewBox="0 0 30 22" aria-hidden="true" fill="none">
  <g class="brand-arrow__main">
    <path class="brand-arrow__spine" d="M2.6 10.45H22.15" />
    <path class="brand-arrow__head" d="M17.15 5.55L22.35 10.45L17.15 15.35" />
  </g>
  <path class="brand-arrow__pulse" d="M2.6 10.45H8.35" />
</svg>

<style>
  .brand-arrow {
    --brand-arrow-angle: 0deg;
    width: 1.3rem;
    height: 1.3rem;
    overflow: visible;
    transform: rotate(var(--brand-arrow-angle));
    transform-origin: 50% 50%;
    transition: transform 420ms var(--ease-out);
  }

  .brand-arrow--down { --brand-arrow-angle: 90deg; }
  .brand-arrow--left { --brand-arrow-angle: 180deg; }
  .brand-arrow--up { --brand-arrow-angle: -90deg; }

  .brand-arrow__main,
  .brand-arrow__pulse {
    vector-effect: non-scaling-stroke;
  }

  .brand-arrow__main {
    stroke: currentColor;
    stroke-width: 2.02;
    stroke-linecap: square;
    stroke-linejoin: miter;
    opacity: 0.48;
    transform-box: fill-box;
    transform-origin: left center;
    transition:
      opacity 320ms ease,
      transform 420ms var(--ease-out);
  }

  .brand-arrow__pulse {
    stroke: var(--accent);
    stroke-width: 2.08;
    stroke-linecap: round;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: left center;
    animation: brand-arrow-pulse 1.58s var(--ease-in-out) infinite;
  }

  :global(a:hover) .brand-arrow,
  :global(a:focus-visible) .brand-arrow {
    transform: rotate(var(--brand-arrow-angle)) translateX(0.14rem);
  }

  :global(a:hover) .brand-arrow__main,
  :global(a:focus-visible) .brand-arrow__main {
    opacity: 0.68;
    transform: scaleX(1.025);
  }

  :global(a:hover) .brand-arrow__pulse,
  :global(a:focus-visible) .brand-arrow__pulse {
    animation-duration: 1.02s;
  }

  @keyframes brand-arrow-pulse {
    0% {
      opacity: 0;
      transform: translateX(-1px) scaleX(0.72);
    }
    15% {
      opacity: 0.18;
    }
    34% {
      opacity: 0.96;
      transform: translateX(3.8px) scaleX(1);
    }
    72% {
      opacity: 0.72;
    }
    100% {
      opacity: 0;
      transform: translateX(13.8px) scaleX(0.76);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-arrow,
    .brand-arrow__main {
      transition: none;
    }

    .brand-arrow__pulse {
      display: none;
      animation: none;
    }
  }
</style>
