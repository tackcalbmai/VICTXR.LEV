---
import { Image } from 'astro:assets';
import Arrow from './Arrow.astro';
import PageContactCTA from './PageContactCTA.astro';
import ResponsiveProjectImage from './ResponsiveProjectImage.astro';
import SiteHeader from './SiteHeader.astro';
import { pageRoutes } from '../data/multipage';
import type { Locale } from '../data/site';
import { projects, type ProjectId } from '../data/projects';
import '../styles/case-study.css';
import '../styles/no-indexes.css';
import '../styles/commercial-hardening.css';

interface Props {
  locale: Locale;
  projectId: ProjectId;
}

const { locale, projectId } = Astro.props;
const project = projects[projectId];
const content = project.content[locale];
const nextId: ProjectId = projectId === 'catrin' ? 'anelika' : 'catrin';
const nextHref = locale === 'lv' ? `/lv/darbi/${nextId}/` : `/work/${nextId}/`;
const alternateHref = locale === 'lv' ? `/work/${projectId}/` : `/lv/darbi/${projectId}/`;
const workHref = `${pageRoutes[locale].work}#work`;
const projectTransitionName = `xo-project-${projectId}`;
---

<div class:list={['case-page', `case-page--${project.theme}`]} data-theme={project.theme} data-project-id={projectId} id="top">
  <SiteHeader locale={locale} alternateHref={alternateHref} multipageNavigation />
  <main id="main-content" tabindex="-1">
    <section class="case-hero" aria-labelledby="case-title">
      <div class="case-hero__topline"><span>{content.eyebrow}</span><span>{content.location} / {content.year}</span></div>
      <h1 id="case-title">{content.title}</h1>
      <p class="case-hero__subtitle">{content.subtitle}</p>
      <ul class="case-hero__services">{content.services.map((service) => <li>{service}</li>)}</ul>
      <a class="case-live-link" href={project.liveUrl} target="_blank" rel="noopener noreferrer" data-analytics-event="project_outbound_click" data-project-id={projectId}>{content.liveLabel}<Arrow direction="right" /></a>
    </section>

    <figure class="case-browser reveal" data-reveal style={`view-transition-name: ${projectTransitionName};`}>
      <div class="case-browser__bar"><span></span><span></span><span></span><em>{new URL(project.liveUrl).hostname}</em></div>
      <ResponsiveProjectImage class="case-screen" desktop={project.hero} mobile={project.mobile} alt={`${content.title} ${locale === 'lv' ? 'mājaslapas responsīvie skati' : 'responsive website views'}`} loading="eager" fetchpriority="high" quality={88} sizes="calc(100vw - 2rem)" />
    </figure>

    <section class="case-proof" aria-label={locale === 'lv' ? 'Pārbaudāmi projekta fakti' : 'Verifiable project facts'}>
      {content.proof.map((item) => (
        <div class="case-proof__item">
          <strong>{item.value}</strong>
          <span>{item.label}</span>
        </div>
      ))}
    </section>

    <section class="case-decision section-pad" data-theme="light" aria-labelledby="case-decision-title" data-motion-reveal>
      <div class="case-decision__topline">
        <span>{locale === 'lv' ? 'Lēmuma punkts' : 'Decision point'}</span>
        <span>XO / DIFFERENT PERSPECTIVE</span>
      </div>
      <h2 id="case-decision-title" class="sr-only">{locale === 'lv' ? 'Noraidītais un izvēlētais virziens' : 'Rejected and chosen direction'}</h2>
      <div class="case-decision__grid">
        <article class="case-decision__option case-decision__option--rejected">
          <span class="case-decision__glyph" aria-hidden="true">X</span>
          <p>{content.decision.rejectedLabel}</p>
          <h3>{content.decision.rejectedTitle}</h3>
          <span>{content.decision.rejectedText}</span>
        </article>
        <article class="case-decision__option case-decision__option--chosen">
          <span class="case-decision__glyph" aria-hidden="true">O</span>
          <p>{content.decision.chosenLabel}</p>
          <h3>{content.decision.chosenTitle}</h3>
          <span>{content.decision.chosenText}</span>
        </article>
      </div>
    </section>

    <section class="case-story section-pad" data-theme="light" data-case-story aria-label={locale === 'lv' ? 'Projekta lēmumu process' : 'Project decision process'}>
      <nav class="case-story__rail" aria-label={locale === 'lv' ? 'Projekta posmi' : 'Case study stages'}>
        <p>{locale === 'lv' ? 'No problēmas līdz rezultātam' : 'From problem to result'}</p>
        <ol>
          {content.sections.map((section, index) => (
            <li>
              <a class:list={[index === 0 && 'is-active']} href={`#case-stage-${index + 1}`} data-case-stage-link={index + 1} aria-current={index === 0 ? 'step' : undefined}>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <i>{section.label.replace(/^\d+\s*\/\s*/, '')}</i>
              </a>
            </li>
          ))}
        </ol>
      </nav>
      <div class="case-narrative">
        {content.sections.map((section, index) => (
          <article class="case-narrative__row reveal" id={`case-stage-${index + 1}`} data-reveal data-case-stage={index + 1}>
            <div><span>{section.label}</span></div>
            <h2>{section.title}</h2>
            <p>{section.text}</p>
          </article>
        ))}
      </div>
    </section>

    {projectId === 'catrin' ? (
      <section class="case-gallery case-gallery--catrin section-pad" aria-label={locale === 'lv' ? 'CATRIN projekta galerija' : 'CATRIN project gallery'}>
        <figure class="reveal" data-reveal><Image src={project.gallery[0]} alt={locale === 'lv' ? 'CATRIN līgavas portrets' : 'CATRIN bridal portrait'} loading="lazy" quality={84} widths={[480, 768, 1100, 1600, 2048]} sizes="(max-width: 760px) calc(100vw - 2rem), 54vw" /></figure>
        <figure class="reveal" data-reveal><Image src={project.gallery[1]} alt={locale === 'lv' ? 'CATRIN kāzu kleitu izlase' : 'CATRIN wedding dress lookbook'} loading="lazy" quality={84} widths={[480, 768, 1100, 1672]} sizes="(max-width: 760px) calc(100vw - 2rem), 44vw" /></figure>
        <figure class="reveal" data-reveal><Image src={project.gallery[2]} alt={locale === 'lv' ? 'CATRIN kāzu kleitas detaļa' : 'CATRIN wedding dress detail'} loading="lazy" quality={84} widths={[480, 768, 1100, 1400, 1672]} sizes="calc(100vw - 4rem)" /></figure>
        <figure class="reveal" data-reveal><Image src={project.gallery[3]} alt={locale === 'lv' ? 'CATRIN salona atmosfēra' : 'CATRIN salon atmosphere'} loading="lazy" quality={84} widths={[480, 768, 1100, 1400, 1672]} sizes="calc(100vw - 4rem)" /></figure>
      </section>
    ) : (
      <section class="case-gallery case-gallery--anelika section-pad" aria-label={locale === 'lv' ? 'ANELIKA responsīvā projekta galerija' : 'ANELIKA responsive project gallery'}>
        <div class="anelika-mark" aria-hidden="true">{project.mark && <Image src={project.mark} alt="" />}</div>
        <figure class="reveal" data-reveal><Image src={project.hero} alt={locale === 'lv' ? 'ANELIKA mājaslapas datora skats' : 'ANELIKA website desktop view'} loading="lazy" quality={86} widths={[640, 960, 1200, 1440]} sizes="(max-width: 760px) calc(100vw - 2rem), 72vw" /></figure>
        <figure class="phone-frame reveal" data-reveal><Image src={project.mobile} alt={locale === 'lv' ? 'ANELIKA mājaslapas mobilais skats' : 'ANELIKA website mobile view'} loading="lazy" quality={86} widths={[260, 320, 390]} sizes="(max-width: 760px) 78vw, 24vw" /></figure>
      </section>
    )}

    <section class="case-result section-pad" data-theme="dark">
      <p>{content.resultNote}</p>
      <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" data-analytics-event="project_outbound_click" data-project-id={projectId}>{content.liveLabel}<Arrow direction="right" /></a>
    </section>

    <nav class="case-next" data-theme="light" aria-label={locale === 'lv' ? 'Projektu navigācija' : 'Project navigation'}>
      <a href={workHref}><Arrow direction="left" />{content.backLabel}</a>
      <a href={nextHref} data-analytics-event="case_study_click" data-project-id={nextId}>{content.nextLabel}<Arrow direction="right" /></a>
    </nav>

    <PageContactCTA locale={locale} context="case" source={`case-${projectId}`} />
  </main>
</div>

<script>
  import { initCaseStudyStory } from '../scripts/case-study-story';
  initCaseStudyStory();
</script>
