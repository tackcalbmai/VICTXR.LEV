---
import Arrow from './Arrow.astro';
import ContactChannels from './ContactChannels.astro';
import ResponsiveProjectImage from './ResponsiveProjectImage.astro';
import SiteHeader from './SiteHeader.astro';
import { contacts } from '../data/contacts';
import { getSiteCopy, type Locale } from '../data/site';
import { projects } from '../data/projects';
import '../styles/home.css';
import '../styles/cinematic.css';
import '../styles/no-indexes.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
const catrin = projects.catrin;
const anelika = projects.anelika;
const contactEmail = contacts.email;
const mailto = `mailto:${contactEmail}?subject=${encodeURIComponent(copy.contact.subject)}`;
const railGlyphs = ['X', 'X', 'X', 'X', 'X', 'O', 'X', 'X'];
const cleanSectionLabel = (label: string) => label.replace(/\s*\/\s*\d+\s*$/, '');
---

<div class="home-shell" data-home-intro="pending" id="top">
  <script is:inline>
    (() => {
      const releaseFallback = (force = false) => {
        const shell = document.querySelector('[data-home-intro]');
        const cinematic = document.querySelector('[data-cinematic-intro]');
        if (!shell || (shell.getAttribute('data-home-intro') !== 'pending' && !(force && cinematic))) return;
        shell.setAttribute('data-intro-bypassed', 'true');
        shell.setAttribute('data-home-intro', 'ready');
        document.documentElement.classList.remove('is-cinematic-intro');
        cinematic?.remove();
        const header = document.querySelector('[data-site-header]');
        header?.removeAttribute('style');
        header?.querySelectorAll('.site-nav--desktop, .site-header__utility').forEach((element) => {
          element.removeAttribute('style');
        });
      };
      window.setTimeout(() => {
        if (!document.querySelector('[data-cinematic-intro]')) releaseFallback();
      }, 2000);
      window.setTimeout(() => releaseFallback(true), 8500);
    })();
  </script>
  <SiteHeader locale={locale} />

  <main id="main-content" tabindex="-1">
    <section class="hero" data-hero aria-labelledby="hero-title">
      <p class="hero__meta" data-intro-meta>{copy.hero.meta}</p>
      <h1 class="hero__title" id="hero-title" aria-label={copy.hero.lines.join(' ')}>
        {copy.hero.lines.map((line, index) => (
          <span class:list={['hero__line', index === 2 && 'hero__line--last', index === 2 && line.length > 9 && 'hero__line--compact']}>
            <span class="hero__line-inner" data-intro-line style={`--line-index:${index}`}>{line}</span>
          </span>
        ))}
      </h1>
      <p class="hero__side-note" data-side-note><span>{copy.hero.sideNote}</span></p>
      <div class="hero__footer" data-intro-footer>
        <p class="hero__intro">{copy.hero.intro}</p>
        <a class="scroll-rail" href="#different-business" data-scroll-journey>
          <span class="scroll-rail__label">{copy.hero.scroll}</span>
          <span class="scroll-rail__window" aria-hidden="true"><span class="scroll-rail__track">{railGlyphs.map((glyph) => <span class:list={[glyph === 'O' && 'is-o']}>{glyph}</span>)}</span></span>
          <Arrow direction="down" />
        </a>
        <nav class="hero__actions" aria-label={locale === 'lv' ? 'Galvenā navigācija' : 'Primary navigation'}>
          <a href="#work" data-analytics-event="view_work_click"><span>{copy.hero.work}</span><Arrow direction="down" /></a>
          <a href="#contact" data-analytics-event="start_project_click"><span>{copy.hero.start}</span><Arrow direction="up" /></a>
        </nav>
      </div>
    </section>

    <section class="disruption" data-disruption aria-labelledby="different-business">
      <div class="disruption__stage">
        <h2 id="different-business" class="sr-only">{copy.disruption.oneBefore}{copy.disruption.oneWord}{copy.disruption.oneAfter}</h2>
        <p class="disruption__line disruption__line--one" data-disruption-one>{copy.disruption.oneBefore}<span class="no-break">{copy.disruption.oneWord}</span>{copy.disruption.oneAfter}</p>
        <span class="disruption__x" data-disruption-x aria-hidden="true">X</span>
        <p class="disruption__line disruption__line--two" data-disruption-two>{copy.disruption.twoBefore}<span class="no-break">{copy.disruption.twoWord}</span>{copy.disruption.twoAfter}</p>
        <p class="disruption__caption" data-disruption-caption>{copy.disruption.caption}</p>
      </div>
    </section>

    <section class="work-heading section-pad" id="work" aria-labelledby="work-title">
      <div class="section-kicker reveal" data-reveal><span>{copy.work.label}</span></div>
      <div class="work-heading__grid"><h2 id="work-title" class="display-title reveal" data-reveal>{copy.work.title}</h2><p class="section-copy reveal" data-reveal>{copy.work.intro}</p></div>
    </section>

    <article class="project-feature project-feature--catrin" data-project data-theme="dark">
      <a class="project-feature__link" href={copy.work.projects.catrin.href} data-analytics-event="case_study_click" data-project-id="catrin">
        <div class="project-feature__topline"><span>{copy.work.label}</span><span>{copy.work.projects.catrin.sector}</span></div>
        <h3 class="project-feature__title" data-project-title>CATRIN</h3>
        <div class="project-feature__media project-feature__media--catrin" data-project-media data-perspective-card><ResponsiveProjectImage class="project-screen" desktop={catrin.hero} mobile={catrin.mobile} alt={locale === 'lv' ? 'CATRIN kāzu salona mājaslapas responsīvie skati' : 'Responsive views of the CATRIN bridal salon website'} loading="lazy" quality={86} sizes="(max-width: 760px) calc(100vw - 2rem), 66vw" /></div>
        <div class="project-feature__bottom"><p>{copy.work.projects.catrin.summary}</p><ul>{copy.work.projects.catrin.scope.map((item) => <li>{item}</li>)}</ul><span class="text-link">{copy.work.caseStudy}<Arrow direction="right" /></span></div>
      </a>
    </article>

    <article class="project-feature project-feature--anelika" data-project data-theme="anelika">
      <a class="project-feature__link" href={copy.work.projects.anelika.href} data-analytics-event="case_study_click" data-project-id="anelika">
        <div class="project-feature__topline"><span>{copy.work.label}</span><span>{copy.work.projects.anelika.sector}</span></div>
        <h3 class="project-feature__title" data-project-title>ANELIKA</h3>
        <div class="project-feature__media project-feature__media--anelika" data-project-media data-perspective-card><ResponsiveProjectImage class="project-screen" desktop={anelika.hero} mobile={anelika.mobile} alt={locale === 'lv' ? 'ANELIKA pakalpojumu mājaslapas responsīvie skati' : 'Responsive views of the ANELIKA property services website'} loading="lazy" quality={86} sizes="(max-width: 760px) calc(100vw - 2rem), 82vw" /></div>
        <div class="project-feature__bottom"><p>{copy.work.projects.anelika.summary}</p><ul>{copy.work.projects.anelika.scope.map((item) => <li>{item}</li>)}</ul><span class="text-link">{copy.work.caseStudy}<Arrow direction="right" /></span></div>
      </a>
    </article>

    <section class="about section-pad" id="about" aria-labelledby="about-title">
      <div class="section-kicker reveal" data-reveal><span>{cleanSectionLabel(copy.about.label)}</span></div>
      <div class="about__top"><h2 class="display-title reveal" id="about-title" data-reveal>{copy.about.title.map((line) => <span>{line}</span>)}</h2><p class="about__aside reveal" data-reveal>{copy.about.aside}</p></div>
      <div class="about__body"><div class="about__copy reveal" data-reveal>{copy.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}</div><p class="about__statement" data-statement>{copy.about.statement.map((line) => <span>{line}</span>)}</p></div>
    </section>

    <section class="approach" id="approach" data-theme="dark" aria-labelledby="approach-title">
      <div class="approach__intro section-pad"><div class="section-kicker"><span>{cleanSectionLabel(copy.approach.label)}</span></div><h2 id="approach-title">{copy.approach.intro}</h2></div>
      <ol class="approach__steps" data-approach>{copy.approach.steps.map((step) => <li data-approach-step><strong>{step}</strong></li>)}</ol>
    </section>

    <section class="services section-pad" id="services" aria-labelledby="services-title">
      <div class="section-kicker reveal" data-reveal><span>{cleanSectionLabel(copy.services.label)}</span></div>
      <h2 class="display-title services__title reveal" id="services-title" data-reveal>{copy.services.title}</h2>
      <div class="services__list">{copy.services.items.map(([, title, text]) => <article class="service-row reveal" data-reveal><h3>{title}</h3><p>{text}</p><span class="service-row__mark" aria-hidden="true">X</span></article>)}</div>
    </section>

    <section class="xo-section" aria-labelledby="xo-title"><div class="xo-section__noise" aria-hidden="true">X X X X X X X X X X X X X X X X X X</div><div class="xo-section__content"><p>{copy.xo.label}</p><h2 id="xo-title">{copy.xo.title.map((line, index) => <span class:list={[index === 1 && 'is-o-line']}>{line}</span>)}</h2><p>{copy.xo.text}</p></div></section>

    <section class="anti-sales" data-anti-sales aria-label={copy.anti.first.join(' ')}><div class="anti-sales__stage"><p class="anti-sales__title anti-sales__title--first" data-anti-first>{copy.anti.first.map((line) => <span>{line}</span>)}</p><p class="anti-sales__title anti-sales__title--second" data-anti-second>{copy.anti.second.map((line) => <span>{line}</span>)}</p><p class="anti-sales__copy" data-anti-copy>{copy.anti.text}</p></div></section>

    <section class="contact section-pad" id="contact" data-theme="dark" aria-labelledby="contact-title">
      <div class="section-kicker"><span>{cleanSectionLabel(copy.contact.label)}</span></div>
      <p class="contact__availability">{copy.contact.availability}</p>
      <h2 class="contact__title" id="contact-title">{copy.contact.title.map((line) => <span>{line}</span>)}</h2>
      {contactEmail && <div class="contact__actions"><a class="contact__email" href={mailto} data-contact-channel="email" data-analytics-event="contact_click" data-analytics-channel="email"><span>{copy.contact.emailLabel}</span><strong>{contactEmail}</strong><Arrow direction="up" /></a><button type="button" data-copy-email data-email={contactEmail} data-copy-label={copy.contact.copy} data-copied-label={copy.contact.copied} data-analytics-event="copy_email_click"><span data-copy-text>{copy.contact.copy}</span><span class="copy-mark" aria-hidden="true"></span></button><p class="sr-only" aria-live="polite" data-copy-status></p></div>}
      <ContactChannels locale={locale} />
      <footer class="site-footer"><span>© <span data-current-year>2026</span> VICTXR.LEV</span><span>{copy.footer.note}</span><a href="#top">{copy.footer.backToTop}<Arrow direction="up" /></a></footer>
    </section>
  </main>
</div>

<script>
  import { initHomeMotion } from '../scripts/home';
  initHomeMotion();
</script>
