---
import Arrow from './Arrow.astro';
import ResponsiveProjectImage from './ResponsiveProjectImage.astro';
import SiteHeader from './SiteHeader.astro';
import { getHomeV2Copy } from '../data/architecture';
import { buildContactHref } from '../data/contact-router';
import { pageRoutes } from '../data/multipage';
import { getSiteCopy, type Locale } from '../data/site';
import { projects } from '../data/projects';
import '../styles/home.css';
import '../styles/cinematic.css';
import '../styles/architecture-v2.css';
import '../styles/motion-bindings.css';
import '../styles/home-mobile-work.css';
import '../styles/no-indexes.css';
import '../styles/commercial-hardening.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = getSiteCopy(locale);
const v2 = getHomeV2Copy(locale);
const routes = pageRoutes[locale];
const contactHref = buildContactHref(locale, 'home', undefined, 'start');
const catrin = projects.catrin;
const anelika = projects.anelika;
const railGlyphs = ['X', 'X', 'X', 'X', 'X', 'O', 'X', 'X'];
---

<div class="home-shell" data-home-intro="pending" id="top">
  <script is:inline>
    (() => {
      const releaseFallback = (force = false) => {
        const shell = document.querySelector('[data-home-intro]');
        const cinematic = document.querySelector('[data-cinematic-intro]');
        if (!shell || (shell.getAttribute('data-home-intro') !== 'pending' && !(force && cinematic))) return;
        shell.setAttribute('data-intro-bypassed', 'true');
        shell.setAttribute('data-home-intro', 'ready');
        document.documentElement.classList.remove('is-cinematic-intro');
        cinematic?.remove();
        const header = document.querySelector('[data-site-header]');
        header?.removeAttribute('style');
        header?.querySelectorAll('.site-nav--desktop, .site-header__utility').forEach((element) => {
          element.removeAttribute('style');
        });
      };
      window.setTimeout(() => {
        if (!document.querySelector('[data-cinematic-intro]')) releaseFallback();
      }, 2000);
      window.setTimeout(() => releaseFallback(true), 6800);
    })();
  </script>

  <SiteHeader locale={locale} multipageNavigation />

  <main id="main-content" tabindex="-1">
    <section class="hero" data-hero aria-labelledby="hero-title">
      <p class="hero__meta" data-intro-meta>{copy.hero.meta}</p>
      <h1 class="hero__title" id="hero-title" aria-label={copy.hero.lines.join(' ')}>
        {copy.hero.lines.map((line, index) => (
          <span class:list={['hero__line', index === 2 && 'hero__line--last', index === 2 && line.length > 9 && 'hero__line--compact']}>
            <span class="hero__line-inner" data-intro-line style={`--line-index:${index}`}>{line}</span>
          </span>
        ))}
      </h1>
      <p class="hero__side-note" data-side-note><span>{copy.hero.sideNote}</span></p>
      <div class="hero__footer" data-intro-footer>
        <p class="hero__intro">{copy.hero.intro}</p>
        <a class="scroll-rail" href="#different-business" data-scroll-journey>
          <span class="scroll-rail__label">{copy.hero.scroll}</span>
          <span class="scroll-rail__window" aria-hidden="true"><span class="scroll-rail__track">{railGlyphs.map((glyph) => <span class:list={[glyph === 'O' && 'is-o']}>{glyph}</span>)}</span></span>
          <Arrow direction="down" />
        </a>
        <nav class="hero__actions" aria-label={locale === 'lv' ? 'Galvenā navigācija' : 'Primary navigation'}>
          <a href={routes.work} data-analytics-event="view_work_click"><span>{copy.hero.work}</span><Arrow direction="right" /></a>
          <a href={contactHref} data-analytics-event="start_project_click"><span>{copy.hero.start}</span><Arrow direction="right" /></a>
        </nav>
      </div>
    </section>

    <section class="disruption" data-disruption aria-labelledby="different-business">
      <div class="disruption__stage">
        <h2 id="different-business" class="sr-only">{copy.disruption.oneBefore}{copy.disruption.oneWord}{copy.disruption.oneAfter}</h2>
        <p class="disruption__line disruption__line--one" data-disruption-one>{copy.disruption.oneBefore}<span class="no-break">{copy.disruption.oneWord}</span>{copy.disruption.oneAfter}</p>
        <span class="disruption__x" data-disruption-x aria-hidden="true">X</span>
        <p class="disruption__line disruption__line--two" data-disruption-two>{copy.disruption.twoBefore}<span class="no-break">{copy.disruption.twoWord}</span>{copy.disruption.twoAfter}</p>
        <p class="disruption__caption" data-disruption-caption>{copy.disruption.caption}</p>
      </div>
    </section>

    <section class="home-v2-work" id="work" data-takeover-zone aria-labelledby="home-v2-work-title">
      <div class="home-v2-work__sticky">
        <div class="home-v2-work__topline"><span>{v2.workLabel}</span><span>XO / PROJECT TAKEOVER</span></div>
        <h2 class="home-v2-work__title" id="home-v2-work-title" data-motion-shift>{v2.workTitle.map((line) => <span>{line}</span>)}</h2>
        <div class="home-v2-projects" aria-label={locale === 'lv' ? 'Atlasīto projektu priekšskatījumi' : 'Selected project previews'}>
          <a class="home-v2-project home-v2-project--catrin" href={copy.work.projects.catrin.href} data-takeover-layer data-analytics-event="case_study_click" data-project-id="catrin">
            <span class="home-v2-project__label">CATRIN / {copy.work.projects.catrin.sector}</span>
            <ResponsiveProjectImage desktop={catrin.hero} mobile={catrin.mobile} alt={locale === 'lv' ? 'CATRIN projekta priekšskatījums' : 'CATRIN project preview'} loading="lazy" quality={84} sizes="(max-width: 760px) 86vw, 58vw" />
          </a>
          <a class="home-v2-project home-v2-project--anelika" href={copy.work.projects.anelika.href} data-takeover-layer data-analytics-event="case_study_click" data-project-id="anelika">
            <span class="home-v2-project__label">ANELIKA / {copy.work.projects.anelika.sector}</span>
            <ResponsiveProjectImage desktop={anelika.hero} mobile={anelika.mobile} alt={locale === 'lv' ? 'ANELIKA projekta priekšskatījums' : 'ANELIKA project preview'} loading="lazy" quality={84} sizes="(max-width: 760px) 91vw, 62vw" />
          </a>
        </div>
        <div class="home-v2-work__bottom">
          <p>{v2.workText}</p>
          <a class="home-v2-link" href={routes.work}>{v2.workCta}<Arrow direction="right" /></a>
        </div>
      </div>
    </section>

    <section class="home-v2-perspective" aria-labelledby="home-v2-perspective-title" data-motion-reveal>
      <div class="home-v2-perspective__topline"><span>{v2.perspectiveLabel}</span><span>XO / QUESTION THE BRIEF</span></div>
      <div class="home-v2-perspective__xo" aria-hidden="true"><span class="x">X</span><span class="o">O</span></div>
      <h2 id="home-v2-perspective-title" data-statement data-motion-shift>{v2.perspectiveTitle.map((line) => <span>{line}</span>)}</h2>
      <div class="home-v2-perspective__bottom">
        <p>{v2.perspectiveText}</p>
        <div class="home-v2-perspective__links" data-approach-step>
          <a class="home-v2-link" href={routes.about}>{v2.aboutCta}<Arrow direction="right" /></a>
          <a class="home-v2-link" href={routes.services}>{v2.servicesCta}<Arrow direction="right" /></a>
        </div>
      </div>
    </section>

    <section class="home-v2-close" data-theme="dark" aria-labelledby="home-v2-close-title" data-motion-reveal>
      <p class="home-v2-close__eyebrow">{v2.closeEyebrow}</p>
      <h2 id="home-v2-close-title">{v2.closeTitle.map((line) => <span>{line}</span>)}</h2>
      <div class="home-v2-close__aside">
        <p>{v2.closeText}</p>
        <a class="home-v2-link" href={contactHref} data-analytics-event="contact_page_click">{v2.closeCta}<Arrow direction="right" /></a>
      </div>
      <footer class="home-v2-close__footer page-contact-cta__footer">
        <span>© <span data-current-year>2026</span> XO WEB / VICTXR.LEV</span>
        <span>{copy.footer.note}</span>
        <a href="#top">{copy.footer.backToTop}<Arrow direction="up" /></a>
      </footer>
    </section>
  </main>
</div>

<script>
  import { initHomeMotion } from '../scripts/home';
  import { initArchitectureMotion } from '../scripts/architecture-motion';
  initHomeMotion();
  initArchitectureMotion();
</script>