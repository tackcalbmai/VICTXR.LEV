---
import Arrow from './Arrow.astro';
import SiteHeader from './SiteHeader.astro';
import { contacts, getSocialContactLinks } from '../data/contacts';
import { contactRoutes, getContactPageCopy } from '../data/architecture';
import { getContactRouterCopy } from '../data/contact-router';
import { getSiteCopy, type Locale } from '../data/site';
import '../styles/architecture-v2.css';
import '../styles/contact-lv-optical.css';
import '../styles/contact-router.css';
import '../styles/motion-bindings.css';
import '../styles/contact-aaa.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = getContactPageCopy(locale);
const router = getContactRouterCopy(locale);
const site = getSiteCopy(locale);
const alternateHref = locale === 'lv' ? contactRoutes.en : contactRoutes.lv;
const defaultIntent = page.options.find((option) => option.id === 'unsure') ?? page.options.at(-1)!;
const whatsappNumber = contacts.whatsapp.replace(/\D/g, '');
const socialLinks = getSocialContactLinks(locale);
const instagram = socialLinks.find((link) => link.channel === 'instagram');
const defaultMessage = `${router.starters.unsure}\n\n${router.prompts.unsureFallback.join('\n\n')}`;
const defaultWhatsapp = whatsappNumber ? `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(defaultMessage)}` : '';
const defaultEmail = contacts.email ? `mailto:${contacts.email}?subject=${encodeURIComponent(defaultIntent.subject)}&body=${encodeURIComponent(defaultMessage)}` : '';
const routerConfig = JSON.stringify({ starters: router.starters, prompts: router.prompts, copied: router.brief.copied });
---

<div
  class="contact-page"
  id="top"
  data-contact-page
  data-contact-email={contacts.email}
  data-contact-whatsapp={whatsappNumber}
>
  <SiteHeader locale={locale} alternateHref={alternateHref} multipageNavigation />
  <main id="main-content" tabindex="-1">
    <section class="contact-hero" aria-labelledby="contact-page-title" data-motion-zone="order">
      <div class="contact-hero__meta"><span>{page.eyebrow}</span><span>XO WEB / VICTXR LEV</span></div>
      <div class="contact-focus-mark" aria-hidden="true" data-xo-focus><span>O</span><i>X</i></div>
      <h1 id="contact-page-title" data-motion-shift>{page.title.map((line, index) => <span class:list={[index === 1 && 'is-accent', index === 2 && 'is-muted']}>{line}</span>)}</h1>
      <p class="contact-hero__intro">{page.intro}</p>
    </section>

    <section class="contact-intents" id="start" aria-labelledby="contact-intents-title" data-contact-intents>
      <div class="contact-intents__heading">
        <p class="mp-kicker">XO / FOCUS</p>
        <h2 id="contact-intents-title">{page.chooseLabel}</h2>
      </div>
      <div class="contact-intents__list">
        {page.options.map((option) => (
          <button
            class:list={['contact-intent', option.id === defaultIntent.id && 'is-active']}
            type="button"
            data-contact-intent={option.id}
            data-contact-subject={option.subject}
            data-analytics-event="contact_intent_select"
            data-analytics-intent={option.id}
            aria-pressed={option.id === defaultIntent.id ? 'true' : 'false'}
          >
            <span class="contact-intent__index">{option.index}</span>
            <span class="contact-intent__title">{option.title}</span>
            <span class="contact-intent__text">{option.text}</span>
            <span class="contact-intent__mark" aria-hidden="true"><i>X</i><b>O</b></span>
          </button>
        ))}
      </div>
    </section>

    <section class="contact-talk" id="talk" data-theme="dark" aria-labelledby="contact-talk-title" data-motion-reveal>
      <div class="contact-direct__topline"><span>{page.directLabel}</span><span data-contact-selection>{defaultIntent.title}</span></div>
      <div class="contact-talk__heading">
        <div>
          <p class="mp-kicker">{router.talk.kicker}</p>
          <h2 id="contact-talk-title">{router.talk.title.map((line) => <span>{line}</span>)}</h2>
        </div>
        <p>{router.talk.intro}</p>
      </div>

      {defaultWhatsapp && (
        <a class="contact-talk__primary" href={defaultWhatsapp} target="_blank" rel="noopener noreferrer" data-router-whatsapp data-contact-channel="whatsapp" data-analytics-event="contact_click" data-analytics-channel="whatsapp">
          <span class="contact-talk__primary-mark" aria-hidden="true">O</span>
          <strong>{router.talk.whatsapp}</strong>
          <p>{router.talk.whatsappNote}</p>
          <Arrow direction="right" />
        </a>
      )}

      <div class="contact-talk__secondary">
        <a href="#brief" data-analytics-event="contact_brief_open">
          <strong>{router.talk.brief}</strong>
          <p>{router.talk.briefNote}</p>
          <Arrow direction="down" />
        </a>
        {defaultEmail && (
          <a href={defaultEmail} data-router-email data-contact-channel="email" data-analytics-event="contact_click" data-analytics-channel="email">
            <strong>{router.talk.email}</strong>
            <p>{router.talk.emailNote}</p>
            <Arrow direction="right" />
          </a>
        )}
        {instagram && (
          <a href={instagram.href} target="_blank" rel="noopener noreferrer" data-contact-channel="instagram" data-analytics-event="contact_click" data-analytics-channel="instagram">
            <strong>{router.talk.instagram}</strong>
            <p>{router.talk.instagramNote}</p>
            <Arrow direction="right" />
          </a>
        )}
      </div>
      <p class="contact-talk__note">{page.note}</p>
    </section>

    <section class="contact-brief" id="brief" aria-labelledby="contact-brief-title">
      <div class="contact-brief__head">
        <div>
          <p class="mp-kicker">{router.brief.kicker}</p>
          <h2 id="contact-brief-title">{router.brief.title.map((line) => <span>{line}</span>)}</h2>
        </div>
        <p>{router.brief.intro}</p>
      </div>

      <form class="contact-brief__form" data-contact-brief>
        <div class="contact-brief__row">
          <label for={`brief-business-${locale}`}>{router.brief.business}</label>
          <input id={`brief-business-${locale}`} name="business" type="text" autocomplete="organization" aria-label={router.brief.business} placeholder={router.brief.businessPlaceholder} />
        </div>
        <div class="contact-brief__row">
          <label for={`brief-website-${locale}`}>{router.brief.website}</label>
          <input id={`brief-website-${locale}`} name="website" type="url" inputmode="url" autocomplete="url" aria-label={router.brief.website} placeholder={router.brief.websitePlaceholder} />
        </div>
        <div class="contact-brief__row">
          <label for={`brief-problem-${locale}`}>{router.brief.problem}</label>
          <textarea id={`brief-problem-${locale}`} name="problem" rows="4" aria-label={router.brief.problem} placeholder={router.brief.problemPlaceholder}></textarea>
        </div>
        <div class="contact-brief__row">
          <label for={`brief-change-${locale}`}>{router.brief.change}</label>
          <textarea id={`brief-change-${locale}`} name="change" rows="3" aria-label={router.brief.change} placeholder={router.brief.changePlaceholder}></textarea>
        </div>
        <div class="contact-brief__actions">
          {defaultWhatsapp && (
            <a href={defaultWhatsapp} target="_blank" rel="noopener noreferrer" data-router-whatsapp data-brief-whatsapp data-contact-channel="whatsapp" data-analytics-event="contact_brief_send" data-analytics-channel="whatsapp">
              <span>{router.brief.whatsapp}</span><Arrow direction="right" />
            </a>
          )}
          {defaultEmail && (
            <a href={defaultEmail} data-router-email data-contact-channel="email" data-analytics-event="contact_brief_send" data-analytics-channel="email">
              <span>{router.brief.email}</span><Arrow direction="right" />
            </a>
          )}
          <button type="button" data-copy-brief data-analytics-event="copy_brief_click"><span data-copy-brief-label>{router.brief.copy}</span></button>
        </div>
        <p class="sr-only" aria-live="polite" data-copy-brief-status></p>
      </form>
      <p class="contact-brief__note">{router.brief.note}</p>
      <footer class="contact-brief__footer page-contact-cta__footer">
        <span>© <span data-current-year>2026</span> XO WEB / VICTXR.LEV</span>
        <span>{site.footer.note}</span>
        <a href="#top">{site.footer.backToTop}<Arrow direction="up" /></a>
      </footer>
    </section>
  </main>
  <script is:inline type="application/json" data-contact-router-config set:html={routerConfig}></script>
</div>

<script>
  import { initArchitectureMotion } from '../scripts/architecture-motion';
  import { initContactRouter } from '../scripts/contact-router';
  initArchitectureMotion();
  initContactRouter();
</script>
