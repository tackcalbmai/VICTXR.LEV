---
import Arrow from './Arrow.astro';
import { buildContactHref, getPageContactCopy, type ContactContext } from '../data/contact-router';
import { getSiteCopy, type Locale } from '../data/site';
import '../styles/architecture-v2.css';
import '../styles/motion-bindings.css';

interface Props {
  locale: Locale;
  label?: string;
  context?: ContactContext;
  source?: string;
}

const { locale, label, context = 'default', source } = Astro.props;
const site = getSiteCopy(locale);
const copy = getPageContactCopy(locale, context);
const href = buildContactHref(locale, source ?? context, undefined, 'start');
const eyebrow = label ?? copy.eyebrow;
---

<section class="page-contact-cta" data-theme="dark" data-motion-reveal aria-labelledby="page-contact-cta-title">
  <div class="page-contact-cta__topline">
    <span>{eyebrow}</span>
    <span>XO → O</span>
  </div>
  <div class="page-contact-cta__body">
    <h2 id="page-contact-cta-title">{copy.title.map((line) => <span>{line}</span>)}</h2>
    <div class="page-contact-cta__aside">
      <p>{copy.text}</p>
      <a href={href} data-analytics-event="contact_page_click" data-contact-context={source ?? context}>{copy.cta}<Arrow direction="right" /></a>
    </div>
  </div>
  <footer class="page-contact-cta__footer">
    <span>© <span data-current-year>2026</span> XO WEB / VICTXR.LEV</span>
    <span>{site.footer.note}</span>
    <a href="#top">{site.footer.backToTop}<Arrow direction="up" /></a>
  </footer>
</section>

<style>
  @media (max-width: 760px) {
    .page-contact-cta h2 {
      font-size: clamp(3rem, 16.3vw, 6.2rem);
    }
  }
</style>

<script>
  import { initArchitectureMotion } from '../scripts/architecture-motion';
  initArchitectureMotion();
</script>
