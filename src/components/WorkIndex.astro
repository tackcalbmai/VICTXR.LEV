---
import Arrow from './Arrow.astro';
import PageContact from './PageContact.astro';
import ResponsiveProjectImage from './ResponsiveProjectImage.astro';
import SiteHeader from './SiteHeader.astro';
import { getMultipageCopy, pageRoutes } from '../data/multipage';
import { projects } from '../data/projects';
import { getSiteCopy, type Locale } from '../data/site';
import '../styles/multipage.css';
import '../styles/multipage-optical.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = getMultipageCopy(locale).work;
const site = getSiteCopy(locale);
const routes = pageRoutes[locale];
const alternateHref = locale === 'lv' ? pageRoutes.en.work : pageRoutes.lv.work;
const projectIds = ['catrin', 'anelika'] as const;
---

<div class="mp-page mp-work" id="top">
  <SiteHeader locale={locale} alternateHref={alternateHref} contactHref="#contact" multipageNavigation />
  <main id="main-content" tabindex="-1">
    <section class="mp-hero mp-work__hero" aria-labelledby="work-index-title">
      <div class="mp-hero__meta"><span>{page.eyebrow}</span><span>XO WEB / VICTXR LEV</span></div>
      <h1 id="work-index-title">{page.title.map((line, index) => <span class:list={[index === 1 && 'is-shifted', index === 2 && 'is-muted']}>{line}</span>)}</h1>
      <div class="mp-hero__bottom">
        <p>{page.intro}</p>
        <p class="mp-hero__proof">{page.proof}</p>
        <a href="#work">{site.hero.scroll}<Arrow direction="down" /></a>
      </div>
    </section>

    <section class="work-exhibition" id="work" aria-label={page.eyebrow}>
      {projectIds.map((projectId, index) => {
        const project = projects[projectId];
        const card = site.work.projects[projectId];
        const caseCopy = project.content[locale];
        const projectTransitionName = `xo-project-${projectId}`;
        return (
          <article class:list={['work-exhibit', `work-exhibit--${projectId}`]} data-theme={projectId === 'catrin' ? 'dark' : 'anelika'}>
            <a class="work-exhibit__link" href={card.href} data-analytics-event="case_study_click" data-project-id={projectId}>
              <div class="work-exhibit__topline">
                <span>0{index + 1} / 02</span>
                <span>{card.sector}</span>
              </div>
              <div class="work-exhibit__name" aria-hidden="true">{caseCopy.title}</div>
              <figure class="work-exhibit__media" style={`view-transition-name: ${projectTransitionName};`}>
                <ResponsiveProjectImage class="work-exhibit__image" desktop={project.hero} mobile={project.mobile} alt={`${caseCopy.title} ${locale === 'lv' ? 'mājaslapas skats' : 'website view'}`} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'auto'} quality={88} sizes="(max-width: 760px) calc(100vw - 2rem), 70vw" />
              </figure>
              <div class="work-exhibit__caption">
                <div><span>{page.projectLabel}</span><h2>{caseCopy.title}</h2></div>
                <p>{card.summary}</p>
                <span class="work-exhibit__cta">{site.work.caseStudy}<Arrow direction="right" /></span>
              </div>
            </a>
            <a class="work-exhibit__live" href={project.liveUrl} target="_blank" rel="noopener noreferrer" data-analytics-event="project_outbound_click" data-project-id={projectId}>{page.liveLabel}<Arrow direction="right" /></a>
          </article>
        );
      })}
    </section>

    <section class="mp-closing mp-closing--work section-pad">
      <p class="mp-kicker">XO / DIFFERENT PERSPECTIVE</p>
      <h2>{page.closing.map((line, index) => <span class:list={[index === 1 && 'is-accent']}>{line}</span>)}</h2>
      <p>{page.closingText}</p>
      <a class="mp-text-link" href={routes.about}>{site.nav.about}<Arrow direction="right" /></a>
    </section>

    <PageContact locale={locale} />
  </main>
</div>
