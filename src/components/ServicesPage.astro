---
import Arrow from './Arrow.astro';
import PageContactCTA from './PageContactCTA.astro';
import SiteHeader from './SiteHeader.astro';
import { buildContactHref, type ContactIntentId } from '../data/contact-router';
import { getMultipageCopy, pageRoutes } from '../data/multipage';
import { getSiteCopy, type Locale } from '../data/site';
import '../styles/multipage.css';
import '../styles/multipage-services-hero.css';
import '../styles/services-focus.css';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const page = getMultipageCopy(locale).services;
const site = getSiteCopy(locale);
const routes = pageRoutes[locale];
const alternateHref = locale === 'lv' ? pageRoutes.en.services : pageRoutes.lv.services;
const contactHref = buildContactHref(locale, 'services', 'unsure', 'start');
const serviceIntent = (index: string): ContactIntentId => ['02', '05', '06'].includes(index) ? 'fix' : 'zero';
---

<div class="mp-page mp-services" id="top">
  <SiteHeader locale={locale} alternateHref={alternateHref} multipageNavigation />
  <main id="main-content" tabindex="-1">
    <section class="mp-hero mp-services__hero" aria-labelledby="services-page-title">
      <div class="mp-hero__meta"><span>{page.eyebrow}</span><span>XO / PROBLEM FIRST</span></div>
      <h1 id="services-page-title" data-motion-shift>{page.title.map((line, index) => <span class:list={[index === 1 && 'is-shifted', index === 2 && 'is-accent']}>{line}</span>)}</h1>
      <p class="mp-services__intro">{page.intro}</p>
      <a class="mp-services__jump" href="#service-list" data-analytics-event="services_explore_click">{locale === 'lv' ? 'Skatīt variantus' : 'See the options'}<Arrow direction="down" /></a>
    </section>

    <section class="services-decision" id="service-list" aria-label={page.eyebrow}>
      {page.services.map((service) => {
        const href = buildContactHref(locale, `service-${service.index}`, serviceIntent(service.index), 'talk');
        return (
        <article class="service-decision" data-motion-reveal data-service-id={service.index}>
          <div class="service-decision__head">
            <span>{service.index}</span>
            <h2>{service.title}</h2>
            <span class="service-decision__mark" aria-hidden="true"><i>X</i><b>O</b></span>
          </div>
          <div class="service-decision__body">
            <div>
              <span>{locale === 'lv' ? 'Kad tas ir jēgpilni' : 'When it makes sense'}</span>
              <p>{service.when}</p>
            </div>
            <div>
              <span>{locale === 'lv' ? 'Ko tu saņem' : 'What changes'}</span>
              <p>{service.result}</p>
            </div>
            <a class="service-decision__cta" href={href} data-analytics-event="service_contact_click" data-service-id={service.index}>
              <span>{page.serviceCta}</span><Arrow direction="right" />
            </a>
          </div>
        </article>
        );
      })}
    </section>

    <section class="services-anti" data-theme="dark" aria-labelledby="services-anti-title" data-motion-reveal>
      <div class="services-anti__noise" aria-hidden="true">X O X O X O X O X O X O</div>
      <div class="services-anti__inner">
        <p class="mp-kicker">ANTI-SALES / ON PURPOSE</p>
        <h2 id="services-anti-title">{page.antiTitle.map((line, index) => <span class:list={[index === 1 && 'is-accent']}>{line}</span>)}</h2>
        <p>{page.antiText}</p>
      </div>
    </section>

    <section class="services-process section-pad" aria-labelledby="services-process-title" data-motion-reveal>
      <p class="mp-kicker">{page.processLabel}</p>
      <h2 id="services-process-title">{page.processTitle}</h2>
      <p>{page.processText}</p>
      <div class="services-process__links">
        <a class="mp-text-link" href={routes.work}>{site.nav.work}<Arrow direction="right" /></a>
        <a class="mp-text-link" href={contactHref}>{site.nav.contact}<Arrow direction="right" /></a>
      </div>
    </section>

    <PageContactCTA locale={locale} context="services" source="services" />
  </main>
</div>
