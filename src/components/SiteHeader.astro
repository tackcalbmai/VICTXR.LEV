---
import type { Locale } from '../data/site';
import { getSiteCopy } from '../data/site';
import { pageRoutes } from '../data/multipage';
import ContactChannels from './ContactChannels.astro';
import '../styles/brand.css';
import '../styles/no-indexes.css';
import '../styles/commercial-hardening.css';

interface Props {
  locale: Locale;
  alternateHref?: string;
  contactHref?: string;
  multipageNavigation?: boolean;
}

const { locale, alternateHref, contactHref, multipageNavigation = false } = Astro.props;
const copy = getSiteCopy(locale);
const home = copy.homeHref;
const routes = pageRoutes[locale];
const resolvedContactHref = contactHref ?? `${home}#contact`;
const navHrefs = multipageNavigation
  ? { work: routes.work, about: routes.about, services: routes.services }
  : { work: `${home}#work`, about: `${home}#about`, services: `${home}#services` };
const available = copy.contact.status;
const alternateLanguage = locale === 'lv' ? 'en' : 'lv';
const languageLabel = locale === 'lv' ? 'Pārslēgt uz angļu valodu' : 'Switch to Latvian';
const homeLabel = locale === 'lv' ? 'VICTXR.LEV — sākums' : 'VICTXR.LEV — home';
---

<header class="site-header" data-site-header>
  <a class="site-brand" href={home} aria-label={homeLabel}>
    <span>VICT</span><span class="site-brand__letter-wrap"><span data-brand-letter>X</span></span><span>R</span><span class="site-brand__dot">.</span><span>LEV</span>
  </a>
  <span class="site-brand-submark" data-xo-submark aria-hidden="true">
    <span class="site-brand-submark__core" data-xo-submark-core><b>X</b><b>O</b></span>
    <span class="site-brand-submark__tail" data-xo-submark-tail><span class="site-brand-submark__dot">·</span><span class="site-brand-submark__web">WEB</span></span>
  </span>

  <nav class="site-nav site-nav--desktop" aria-label={copy.nav.menu}>
    <a href={navHrefs.work}>{copy.nav.work}</a>
    <a href={navHrefs.about}>{copy.nav.about}</a>
    <a href={navHrefs.services}>{copy.nav.services}</a>
    <a href={resolvedContactHref}>{copy.nav.contact}</a>
  </nav>

  <div class="site-header__utility">
    <a class="site-status" href={resolvedContactHref} data-analytics-event="availability_click"><span aria-hidden="true"></span>{available}</a>
    <a class="site-language" href={alternateHref ?? copy.alternateHref} hreflang={alternateLanguage} lang={alternateLanguage} aria-label={languageLabel} data-analytics-event="language_switch">{copy.alternateLabel}</a>
    <button class="site-menu-button" type="button" data-menu-toggle aria-expanded="false" aria-controls="mobile-menu">
      <span class="sr-only" data-menu-label data-open-label={copy.nav.menu} data-close-label={copy.nav.close}>{copy.nav.menu}</span>
      <span class="site-menu-button__lines" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<noscript>
  <nav class="no-js-nav" aria-label={copy.nav.menu}>
    <a href={navHrefs.work}>{copy.nav.work}</a>
    <a href={navHrefs.about}>{copy.nav.about}</a>
    <a href={navHrefs.services}>{copy.nav.services}</a>
    <a href={resolvedContactHref}>{copy.nav.contact}</a>
  </nav>
</noscript>

<div class="mobile-menu" id="mobile-menu" data-mobile-menu aria-hidden="true" inert>
  <div class="mobile-menu__meta">
    <span>VICTXR.LEV</span>
    <span>{copy.hero.meta}</span>
  </div>
  <nav class="mobile-menu__nav" aria-label={copy.nav.menu}>
    <a href={navHrefs.work}>{copy.nav.work}</a>
    <a href={navHrefs.about}>{copy.nav.about}</a>
    <a href={navHrefs.services}>{copy.nav.services}</a>
    <a href={resolvedContactHref}>{copy.nav.contact}</a>
  </nav>
  <div class="mobile-menu__bottom">
    <ContactChannels locale={locale} variant="menu" />
    <div class="mobile-menu__footer"><span>{locale === 'lv' ? 'Latvija' : 'Latvia'}</span><a href={resolvedContactHref}>{available}</a></div>
  </div>
</div>

<script>
  import { initXoIdentity } from '../scripts/xo-identity';
  initXoIdentity();
</script>
