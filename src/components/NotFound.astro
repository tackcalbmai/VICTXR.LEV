---
import Arrow from './Arrow.astro';
import type { Locale } from '../data/site';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const isLv = locale === 'lv';
const home = isLv ? '/lv/' : '/';
const copy = isLv
  ? {
      lead: 'Kaut kas nav pareizi.',
      reply: 'Labi.',
      back: 'Atpakaļ pie tā, kas strādā',
    }
  : {
      lead: 'Something looks wrong.',
      reply: 'Good.',
      back: 'Back to the working part',
    };
---

<main class="not-found" id="main-content" tabindex="-1">
  <a class="not-found__brand" href={home} data-home-link><strong>XO WEB</strong><small>BY VICTXR.LEV</small></a>
  <p>{copy.lead}</p>
  <h1><span>{copy.reply}</span><strong>404</strong></h1>
  <a class="not-found__back" href={home} data-home-link><span data-not-found-back>{copy.back}</span> <Arrow direction="right" /></a>
</main>

<style>
  .not-found {
    display: grid;
    min-height: 100svh;
    grid-template-rows: auto 1fr auto;
    padding: calc(var(--gutter) + var(--safe-top)) var(--gutter) calc(var(--gutter) + var(--safe-bottom));
    overflow: hidden;
  }

  .not-found__brand {
    display: inline-grid;
    width: max-content;
    gap: 0.25rem;
    font-size: 1.1rem;
    font-weight: 800;
    letter-spacing: -0.05em;
  }

  .not-found__brand strong { font: inherit; }

  .not-found__brand small {
    font-size: 0.42rem;
    font-weight: 680;
    letter-spacing: 0.14em;
    opacity: 0.62;
  }

  .not-found > p {
    align-self: center;
    text-transform: uppercase;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .not-found h1 {
    position: absolute;
    inset: 50% auto auto 50%;
    text-transform: uppercase;
    transform: translate(-50%, -50%) rotate(-4deg);
  }

  .not-found h1 span,
  .not-found h1 strong {
    display: block;
    font-size: clamp(7rem, 25vw, 25rem);
    font-weight: 790;
    line-height: 0.7;
    letter-spacing: -0.1em;
  }

  .not-found h1 span {
    color: var(--accent);
    font-size: clamp(4rem, 10vw, 10rem);
    transform: translateX(-16vw);
  }

  .not-found__back {
    z-index: 2;
    display: inline-flex;
    width: max-content;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.2rem;
    border-bottom: 1px solid currentColor;
    text-transform: uppercase;
    font-size: 0.65rem;
    font-weight: 720;
    letter-spacing: 0.09em;
  }
</style>
