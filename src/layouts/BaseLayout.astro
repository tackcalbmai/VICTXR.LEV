---
import '../styles/global.css';
import '../styles/pinned-cues.css';
import '../styles/commercial-density.css';
import '../styles/laptop-responsive.css';
import '../styles/short-desktop-composition.css';
import '../styles/short-desktop-final.css';
import '../styles/experience-refinement.css';
import '../styles/experience-geometry.css';
import '../styles/experience-interactions.css';
import '../styles/lv-diacritics.css';
import ContactDock from '../components/ContactDock.astro';
import { contacts, getSocialContactLinks } from '../data/contacts';

interface Props {
  title: string;
  description: string;
  lang?: 'en' | 'lv';
  canonicalPath?: string;
  alternatePath?: string;
  robots?: string;
  preloadSerif?: boolean;
  socialImagePath?: string;
  socialImageAlt?: string;
}

const {
  title,
  description,
  lang = 'en',
  canonicalPath = '/',
  alternatePath = lang === 'en' ? '/lv/' : '/',
  robots = 'index,follow,max-image-preview:large',
  preloadSerif = false,
  socialImagePath = '/xo-web-preview.png',
  socialImageAlt,
} = Astro.props;

const publicTitle = title.replace(' | VICTXR.LEV', '');
const siteUrl = Astro.site ?? new URL('https://xoweb.lv');
const canonical = new URL(canonicalPath, siteUrl);
const alternate = new URL(alternatePath, siteUrl);
const xDefault = new URL(lang === 'en' ? canonicalPath : alternatePath, siteUrl);
const socialImage = new URL(socialImagePath, siteUrl);
const locale = lang === 'lv' ? 'lv_LV' : 'en_US';
const alternateLocale = lang === 'lv' ? 'en_US' : 'lv_LV';
const skipLabel = lang === 'lv' ? 'Pāriet uz saturu' : 'Skip to content';
const defaultSocialAlt = lang === 'lv'
  ? 'XO WEB — mājaslapu dizains un izstrāde Latvijā'
  : 'XO WEB — web design and development from Latvia';
const resolvedSocialAlt = socialImageAlt ?? defaultSocialAlt;
const socialProfiles = getSocialContactLinks(lang)
  .filter((contact) => contact.channel === 'instagram')
  .map((contact) => contact.href);
const websiteId = new URL('/#website', siteUrl).toString();
const brandId = new URL('/#brand', siteUrl).toString();
const creatorId = new URL('/#creator', siteUrl).toString();
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': websiteId,
      url: siteUrl.toString(),
      name: 'XO WEB',
      alternateName: 'xoweb.lv',
      description,
      inLanguage: lang,
      brand: { '@id': brandId },
      creator: { '@id': creatorId },
      provider: { '@id': creatorId },
    },
    {
      '@type': 'Brand',
      '@id': brandId,
      name: 'XO WEB',
      alternateName: 'xoweb.lv',
      url: siteUrl.toString(),
      sameAs: socialProfiles.length ? socialProfiles : undefined,
    },
    {
      '@type': 'Person',
      '@id': creatorId,
      name: 'Viktors Levdanskis',
      alternateName: 'VICTXR.LEV',
      url: siteUrl.toString(),
      jobTitle: lang === 'lv' ? 'Tīmekļa dizainers un izstrādātājs' : 'Web designer and developer',
      email: contacts.email ? `mailto:${contacts.email}` : undefined,
      sameAs: socialProfiles.length ? socialProfiles : undefined,
      address: { '@type': 'PostalAddress', addressCountry: 'LV' },
      knowsAbout: ['Web design', 'Web development', 'User experience', 'Technical SEO', 'Multilingual websites'],
    },
  ],
};
---

<!doctype html>
<html lang={lang} class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <script is:inline>document.documentElement.classList.remove('no-js');</script>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content="Viktors Levdanskis" />
    <meta name="theme-color" content="#f2f0e9" />
    <meta name="color-scheme" content="light" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={lang === 'en' ? 'lv' : 'en'} href={alternate} />
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/onest-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
    {lang === 'lv' && <link rel="preload" href="/fonts/onest-latin-ext.woff2" as="font" type="font/woff2" crossorigin="anonymous" />}
    {preloadSerif && <link rel="preload" href="/fonts/noto-serif-display-latin.woff2" as="font" type="font/woff2" crossorigin="anonymous" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="XO WEB" />
    <meta property="og:title" content={publicTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content={resolvedSocialAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={locale} />
    <meta property="og:locale:alternate" content={alternateLocale} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={publicTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={resolvedSocialAlt} />
    <title>{publicTitle}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script is:inline>
      const navigation = performance.getEntriesByType?.('navigation')?.[0];
      if (navigation?.type === 'reload' && !location.hash) {
        if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
        const resetReloadScroll = () => window.scrollTo({ top: 0, left: 0, behavior: 'auto' });
        resetReloadScroll();
        window.addEventListener('DOMContentLoaded', resetReloadScroll, { once: true });
        window.addEventListener('load', () => window.requestAnimationFrame(resetReloadScroll), { once: true });
        window.addEventListener('pageshow', resetReloadScroll, { once: true });
      } else if ('scrollRestoration' in history) {
        history.scrollRestoration = 'auto';
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{skipLabel}</a>
    <slot />
    <ContactDock locale={lang} canonicalPath={canonicalPath} />
    <script>
      import { initExperienceRefinementMotion } from '../scripts/experience-refinement';
      import { initPinnedScrollCues } from '../scripts/pinned-cues';
      import { initSiteUI } from '../scripts/site';
      initSiteUI();
      initPinnedScrollCues();
      initExperienceRefinementMotion();
    </script>
  </body>
</html>
