---
import '../styles/global.css';
import '../styles/hero-experience.css';
import '../styles/hero-polish.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'VICTXR LEV — Independent web designer & developer',
  description = 'Websites for businesses that refuse to look ordinary.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1f0eb" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <script is:inline>
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }

      const resetVictxrScroll = () => {
        if (location.hash) {
          history.replaceState(null, '', `${location.pathname}${location.search}`);
        }
        window.scrollTo(0, 0);
      };

      resetVictxrScroll();
      window.addEventListener('pageshow', () => {
        requestAnimationFrame(() => {
          resetVictxrScroll();
          requestAnimationFrame(resetVictxrScroll);
        });
      }, { once: true });
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
