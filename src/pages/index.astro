---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <div class="home-shell" data-home-intro="pending">
    <header class="site-header" data-intro-header>
      <a class="site-header__brand" href="/" aria-label="VICTXR LEV home">
        <span>VICT</span><span class="site-header__brand-letter" data-brand-letter>X</span><span>R</span><span class="site-header__dot">.</span><span>LEV</span>
      </a>

      <div class="site-header__meta" aria-label="Site information">
        <span>Independent web designer & developer</span>
        <span>Latvia</span>
        <span class="site-header__status">Available</span>
      </div>
    </header>

    <main>
      <section class="hero" data-hero>
        <h1 class="hero__title" aria-label="I see things differently">
          <span class="hero__line"><span class="hero__line-inner" data-intro-line>I see</span></span>
          <span class="hero__line"><span class="hero__line-inner" data-intro-line>things</span></span>
          <span class="hero__line hero__line--different">
            <span class="hero__line-inner" data-intro-line><span>different</span><span class="hero__suffix" data-intro-suffix>ly.</span></span>
          </span>
        </h1>

        <div class="hero__footer" data-intro-footer>
          <p class="hero__side-note" data-side-note>
            <span><strong>No templates</strong> were harmed in the making of this website.</span>
          </p>

          <p class="hero__intro">Websites for businesses that refuse to look ordinary.</p>

          <a
            class="hero__scroll"
            href="#different-business"
            data-scroll-journey
            aria-label="Scroll to explore the site"
          >
            <span class="hero__scroll-label">Scroll</span>
            <span class="hero__scroll-window" aria-hidden="true">
              <span class="hero__scroll-track">
                <span>X</span><span>X</span><span>X</span><span>X</span>
                <span>X</span><span>X</span><span>X</span><span>X</span>
              </span>
            </span>
            <span class="hero__scroll-end" aria-hidden="true">↓</span>
          </a>

          <nav class="hero__actions" aria-label="Primary">
            <a href="#work">
              <span>View selected work</span>
              <span class="hero__action-arrow hero__action-arrow--down" aria-hidden="true"></span>
            </a>
            <a href="#contact">
              <span>Start a project</span>
              <span class="hero__action-arrow hero__action-arrow--up" aria-hidden="true"></span>
            </a>
          </nav>
        </div>
      </section>

      <section class="disruption" data-disruption aria-labelledby="different-business">
        <div class="disruption__stage">
          <h2 id="different-business" class="sr-only">Your business isn’t generic</h2>

          <p class="disruption__line disruption__line--one" data-disruption-one>
            Your business isn<span class="type-apostrophe">’</span>t generic.
          </p>

          <span class="disruption__x" data-disruption-x aria-hidden="true">X</span>

          <p class="disruption__line disruption__line--two" data-disruption-two>
            Your website shouldn<span class="type-apostrophe">’</span>t be either.
          </p>

          <p class="disruption__caption" data-disruption-caption>
            I design and build around the business — not around a template.
          </p>
        </div>
      </section>

      <section class="project-entry" id="work" data-catrin aria-labelledby="catrin-title">
        <div class="project-entry__eyebrow">
          <span>Selected work / 01</span>
          <span>Jelgava, Latvia</span>
        </div>

        <h2 class="project-entry__title" id="catrin-title" data-catrin-title>CATRIN</h2>

        <div class="project-entry__details">
          <div class="project-entry__detail project-entry__detail--about">
            <span class="project-entry__label">Project</span>
            <p class="project-entry__client">
              From a local bridal salon to a digital experience that feels as premium as the product itself.
            </p>
          </div>

          <div class="project-entry__detail project-entry__detail--scope">
            <span class="project-entry__label">Scope</span>
            <p class="project-entry__services">
              Web design<br />
              Development<br />
              UX<br />
              Multilingual
            </p>
          </div>
        </div>
      </section>

      <div id="contact" class="sr-only">Contact section follows in a later sprint.</div>
    </main>
  </div>

  <script>
    import { initHomeMotion } from '../scripts/home';

    initHomeMotion();
  </script>
</BaseLayout>

<style>
  .hero__suffix {
    display: inline;
  }

  .type-apostrophe {
    display: inline-block;
    margin-inline: 0.025em 0.015em;
    transform: translateY(-0.035em);
  }

  @media (min-width: 761px) {
    .hero__intro,
    .hero__scroll,
    .hero__actions {
      grid-row: 1;
    }

    .hero__scroll {
      position: relative;
      grid-column: 1 / -1;
      align-self: end;
      justify-self: center;
    }

    .disruption__caption {
      right: auto;
      left: var(--gutter);
      max-width: 24rem;
      font-size: clamp(0.88rem, 0.9vw, 0.98rem);
    }
  }

  @media (max-width: 760px) {
    .hero__line--different .hero__line-inner {
      font-size: 0.69em;
      letter-spacing: -0.055em;
      white-space: nowrap;
    }

    .hero__suffix {
      display: inline;
      margin-left: 0;
      font-size: 1em;
      letter-spacing: inherit;
      transform: none;
    }
  }
</style>
